{
  "l2_id": "histology_pathology",
  "l2_label": "Histology & Pathology",
  "schema_name": "HISTOLOGY_PATHOLOGY",
  "l2_fields": [
    {
      "name": "Species",
      "type": "multi-select",
      "required": true,
      "product_only": false,
      "extractor": "controlled_vocabulary",
      "vocabulary_ref": "species_histology",
      "multi_select": true,
      "allowed_values": [
        "Mouse",
        "Rat",
        "Dog",
        "Non-human primate",
        "Pig",
        "Rabbit",
        "Human",
        "Other"
      ]
    },
    {
      "name": "Sample type",
      "type": "multi-select",
      "required": true,
      "product_only": false,
      "extractor": "controlled_vocabulary",
      "vocabulary_ref": "sample_type_histology",
      "multi_select": true,
      "allowed_values": [
        "FFPE block",
        "Frozen (OCT)",
        "Fresh tissue",
        "Glass slides",
        "Unstained sections"
      ]
    },
    {
      "name": "GLP status",
      "type": "picklist",
      "required": true,
      "product_only": false,
      "extractor": "controlled_vocabulary",
      "vocabulary_ref": "glp_status",
      "allowed_values": [
        "GLP",
        "Non-GLP",
        "Discovery"
      ]
    },
    {
      "name": "Deliverables",
      "type": "multi-select",
      "required": false,
      "product_only": false,
      "extractor": "controlled_vocabulary",
      "vocabulary_ref": "deliverables_histology_l2",
      "multi_select": true,
      "allowed_values": [
        "Glass slides",
        "Whole slide images",
        "Pathology report",
        "SEND data",
        "Raw data"
      ]
    },
    {
      "name": "Turnaround",
      "type": "number",
      "required": false,
      "product_only": false,
      "extractor": "regex",
      "pattern": "turnaround",
      "allowed_values": "days"
    },
    {
      "name": "Pricing unit",
      "type": "picklist",
      "required": false,
      "product_only": false,
      "extractor": "controlled_vocabulary",
      "vocabulary_ref": "pricing_unit_histology",
      "allowed_values": [
        "Per slide",
        "Per sample",
        "Per block",
        "Per study",
        "Per hour"
      ]
    },
    {
      "name": "Capacity",
      "type": "number",
      "required": false,
      "product_only": false,
      "extractor": "regex",
      "pattern": "capacity_slides_per_month",
      "allowed_values": "slides per month"
    }
  ],
