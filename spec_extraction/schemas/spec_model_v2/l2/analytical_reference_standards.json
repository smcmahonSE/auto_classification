{
  "l2_id": "analytical_reference_standards",
  "l2_label": "Analytical & Reference Standards",
  "schema_name": "ANALYTICAL_REFERENCE_STANDARDS",
  "l2_fields": [
    {
      "name": "Standard type",
      "type": "picklist",
      "required": true,
      "product_only": false,
      "extractor": "controlled_vocabulary",
      "vocabulary_ref": "standard_type_ref_standards",
      "allowed_values": [
        "Analytical standard",
        "Certified reference material",
        "QC control",
        "Calibrator",
        "Proficiency test sample"
      ]
    },
    {
      "name": "Analyte(s) / parameter",
      "type": "text",
      "required": true,
      "product_only": false,
      "extractor": "regex",
      "pattern": "labeled_analyte_parameter"
    },
    {
      "name": "Format",
      "type": "picklist",
      "required": false,
      "product_only": false,
      "extractor": "controlled_vocabulary",
      "vocabulary_ref": "physical_format_ref_standards",
      "allowed_values": [
        "Solution",
        "Neat",
        "Lyophilized",
        "Powder"
      ]
    },
    {
      "name": "Regulatory status / intended use",
      "type": "picklist",
      "required": false,
      "product_only": false,
      "extractor": "controlled_vocabulary",
      "vocabulary_ref": "regulatory_status_ref_standards",
      "allowed_values": [
        "RUO",
        "IVD",
        "FDA cleared",
        "CE marked"
      ]
    },
    {
      "name": "Storage conditions",
      "type": "multi-select",
      "required": false,
      "product_only": false,
      "extractor": "controlled_vocabulary",
      "vocabulary_ref": "storage_conditions_ref_standards",
      "multi_select": true,
      "allowed_values": [
        "Room temperature",
        "2-8°C",
        "-20°C",
        "-60 to -80°C",
        "Light sensitive"
      ]
    },
    {
      "name": "Expiration / validity",
      "type": "text",
      "required": false,
      "product_only": false,
      "extractor": "regex",
      "pattern": "labeled_expiration_validity"
    }
  ],
